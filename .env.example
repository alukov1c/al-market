# Server mode: local for the local server, remote for Render.
PORTFOLIO_MODE=local
PORTFOLIO_PORT=3081
# Automatic PORT assignment by Render; required binding to 0.0.0.0.
# PORT=10000
# HOST=0.0.0.0
# Shared secret: a random token of at least 32 characters, excluded from Git.
PORTFOLIO_UPLOAD_TOKEN=
# Local publisher only: exact HTTPS address of your existing Render service.
PORTFOLIO_REMOTE_URL=
# Optional: custom local MetaTrader export directory.
# PORTFOLIO_SOURCE_DIR=
# Optional: private expected account IDs.
# PORTFOLIO_A_LOGIN=
# PORTFOLIO_B_LOGIN=
# Optional persistent data directory on Render (requires a configured disk).
# PORTFOLIO_DATA_DIR=
